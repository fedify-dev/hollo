{
  "name": "@fedify/hollo",
  "description": "Federated single-user microblogging software",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "skills-npm || true",
    "prod": "pnpm run migrate && node --env-file-if-exists=.env --dns-result-order=ipv6first dist/bin/server.js",
    "dev": "pnpm run migrate && pnpm run uno:build && concurrently -k -n uno,app -c blue,green \"pnpm run uno:watch\" \"tsx watch --env-file-if-exists=.env --dns-result-order=ipv6first bin/server.ts\"",
    "worker": "NODE_TYPE=worker node --env-file-if-exists=.env --dns-result-order=ipv6first dist/bin/server.js",
    "list:routes": "tsx --env-file-if-exists=.env bin/routes.ts",
    "measure:memory": "node --expose-gc --import tsx --env-file-if-exists=.env scripts/measure-memory.ts",
    "uno:build": "unocss \"src/**/*.{tsx,ts}\" -o src/public/uno.css",
    "uno:watch": "unocss \"src/**/*.{tsx,ts}\" -o src/public/uno.css --watch",
    "build": "pnpm run uno:build && tsdown",
    "test": "pnpm run migrate:test && vitest",
    "test:ci": "vitest",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:github": "oxlint --format=github .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check",
    "check:ci": "pnpm run typecheck && pnpm run lint:github && pnpm run fmt:check",
    "check:coverage": "pnpm run migrate:test && vitest --coverage",
    "migrate": "drizzle-kit migrate",
    "migrate:test": "dotenvx run -f .env.test -- drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "rebuild-timelines": "tsx --env-file-if-exists=.env scripts/rebuild-timelines.ts"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.1106.0",
    "@fedify/debugger": "~2.3.2",
    "@fedify/fedify": "~2.3.2",
    "@fedify/hono": "~2.3.2",
    "@fedify/markdown-it-hashtag": "~0.3.0",
    "@fedify/markdown-it-mention": "~0.3.0",
    "@fedify/postgres": "~2.3.2",
    "@fedify/vocab": "~2.3.2",
    "@fedify/webfinger": "~2.3.4",
    "@hexagon/base64": "^2.0.4",
    "@hono/node-server": "^2.0.10",
    "@hono/zod-validator": "^0.9.0",
    "@js-temporal/polyfill": "^0.5.0",
    "@logtape/drizzle-orm": "~2.3.0",
    "@logtape/file": "~2.3.0",
    "@logtape/logtape": "~2.3.0",
    "@logtape/sentry": "~2.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@sentry/core": "^10.68.0",
    "@sentry/node": "^10.68.0",
    "@shikijs/markdown-it": "^4.0.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@supercharge/promise-pool": "^3.3.0",
    "argon2": "^0.45.1",
    "cheerio": "^1.2.0",
    "cssfilter": "^0.0.11",
    "csv-writer-portable": "^1.7.6",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "^1.48.1",
    "file-type": "^22.0.1",
    "flydrive": "^2.1.0",
    "hono": "^4.12.34",
    "iso-639-1": "^3.1.5",
    "markdown-it": "^15.0.0",
    "markdown-it-replace-link": "^1.2.2",
    "mime": "^4.1.0",
    "neat-csv": "^7.0.0",
    "open-graph-scraper": "^6.11.0",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "semver": "^7.8.1",
    "sharp": "^0.35.2",
    "ssrfcheck": "^1.4.0",
    "tsx": "^4.23.9",
    "uuidv7-js": "^1.1.4",
    "x-forwarded-fetch": "^0.2.0",
    "xss": "^1.0.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.71.3",
    "@fedify/lint": "~2.3.2",
    "@iconify-json/lucide": "^1.2.111",
    "@reporters/github": "^2.0.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.7.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/cli": "^66.7.5",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.4",
    "linkedom": "^0.18.13",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.77.0",
    "skills-npm": "^1.1.1",
    "timekeeper": "^2.3.1",
    "tsdown": "^0.22.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unocss": "^66.7.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
