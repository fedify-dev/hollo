DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SENTRY_DSN=
SECRET_KEY=secret_key  # generate a secret key with `openssl rand -base64 32`
HOME_URL=https://example.com/  # optional; if present, the home page will redirect to this URL
# Comma-separated locale patterns for Gukhanmun readings, e.g. ko,ko-*
GUKHANMUN=
# Dictionary priority (first match wins); opendict includes all four categories
GUKHANMUN_DICTS=loanwords,opendict:general,opendict:dialect,stdict
# Optional post Markdown extensions; empty disables all:
# https://docs.hollo.social/markdown/
# footnote,deflist,sub,sup,mark,ruby,ins,abbr,tasklist,math
MARKDOWN_EXTENSIONS=

LOG_LEVEL=info
LOG_QUERY=false

BEHIND_PROXY=false
PORT=3000
# BIND=localhost

# Setting ALLOW_PRIVATE_ADDRESS to true disables SSRF (Server-Side Request Forgery) protection
# Set to true to test in local network
# Will be replaced by list of allowed IPs once https://github.com/dahlia/fedify/issues/157
# is implemented.
ALLOW_PRIVATE_ADDRESS=false

REMOTE_ACTOR_FETCH_POSTS=10
# Document-loader call budget per remote context/replies backfill attempt:
REMOTE_REPLIES_SCRAPE_MAX_REQUESTS=200

# File uploads and media storage:
DRIVE_DISK=
STORAGE_URL_BASE=

# Custom emoji uploads storage:
# S3_EMOJI_IMPORT_BUCKET=
EMOJI_IMPORT_MAX_ARCHIVE_BYTES=52428800
EMOJI_IMPORT_MAX_ENTRY_COUNT=1000
EMOJI_IMPORT_MAX_EXTRACTED_BYTES=262144000

# If DRIVE_DISK is "fs":
# FS_STORAGE_PATH=
# EMOJI_IMPORT_FS_PATH=

# If DRIVE_DISK is "s3":
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=false
